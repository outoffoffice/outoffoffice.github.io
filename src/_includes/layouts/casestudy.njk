<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<script>
  try {
    var t = localStorage.getItem('theme');
    if (t === 'dark') document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
  // With JS, a case study never opens as a page of its own: hand this path
  // to the homepage, which shows it in its slide-in sheet (see
  // /js/case-panel.js). Without JS (or with ?solo) this page renders as is.
  if (location.search.indexOf('solo') === -1) {
    try {
      sessionStorage.setItem('openCase', location.pathname);
      location.replace('/#work');
    } catch (e) {}
  }
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- iOS would otherwise turn year ranges like 2017 – 2021 into phone links -->
<meta name="format-detection" content="telephone=no">
<meta name="theme-color" content="#bbff00">
<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg">
<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96">
<link rel="shortcut icon" href="/favicon/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
<title>OutOff — {{ title }}</title>
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="description" content="{{ dek or site.description }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ dek or site.description }}">
<meta property="og:image" content="{% if heroImage or cardImage %}{{ site.url }}/images/{{ heroImage or cardImage }}{% else %}{{ site.url }}/{{ site.image }}{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ dek or site.description }}">
<meta name="twitter:image" content="{% if heroImage or cardImage %}{{ site.url }}/images/{{ heroImage or cardImage }}{% else %}{{ site.url }}/{{ site.image }}{% endif %}">
<link rel="stylesheet" href="/css/fonts.css?v={{ site.version }}">
<link rel="stylesheet" href="/css/shared.css?v={{ site.version }}">
<link rel="stylesheet" href="/css/image-blocks.css?v={{ site.version }}">
<link rel="stylesheet" href="/css/casestudy.css?v={{ site.version }}">
<style>
  .wrap{position:relative; max-width:100vw; overflow-x:clip; min-height:100vh; display:flex; flex-direction:column;}
</style>
</head>
<body>
<div class="wrap">
  <div class="grid-bg"></div>

  <header>
    <div class="header-inner content-col">
      <a href="/" class="logo"><span class="brand">OutOff</span><span class="us">_</span></a>
      <a href="/#work" class="back">← all work</a>
    </div>
  </header>

  <div class="viewport-readout" id="viewport-readout">viewport: —</div>
  <div class="coords" id="coords">x: 000 / y: 000</div>

  <article class="content-col case">
  {#- Project head: kicker, title and dek on the left; the facts in a list
        on the right (below on tablets and phones). Every fact is optional
        and shows only when its front matter field is set — in this order:
          client:     "Studio XY"                (or { name, url })
          role:       "Concept & Interaction Design"
          timeframe:  "2019"
          team:       - { name: "Jane Doe", role: "Sound", url: "https://…" }
          stack:      "Figma / Blender"           (or a list)
          links:      - { label: "Live prototype", url: "https://…" }
          facts:      - { label: "Awards", value: "…" }   (anything else) #}
  <section class="project-head grid">
    <div class="project-intro">
      <div class="kicker">{{ kicker }}</div>
      <h1>{{ title }}</h1>
      {% if dek %}<p class="dek">{{ dek }}</p>{% endif %}
    </div>

    <dl class="case-facts">
      {% if client %}
      <div class="fact"><dt>Client</dt><dd>{% if client.url %}<a href="{{ client.url }}" target="_blank" rel="noopener">{{ client.name }}</a>{% else %}{{ client.name or client }}{% endif %}</dd></div>
      {% endif %}
      {% if role %}<div class="fact"><dt>Role</dt><dd>{{ role }}</dd></div>{% endif %}
      {% if timeframe %}<div class="fact"><dt>Timeframe</dt><dd>{{ timeframe }}</dd></div>{% endif %}
      {% if team and team.length %}
      <div class="fact"><dt>Team</dt><dd><ul>
        {% for p in team %}<li>{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.name }}</a>{% else %}{{ p.name or p }}{% endif %}{% if p.role %} <span class="fact-note">{{ p.role }}</span>{% endif %}</li>{% endfor %}
      </ul></dd></div>
      {% endif %}
      {% if stack %}
      <div class="fact"><dt>Stack</dt><dd><ul>
        {% for tool in stack | asList %}<li>{{ tool }}</li>{% endfor %}
      </ul></dd></div>
      {% endif %}
      {% if links and links.length %}
      <div class="fact"><dt>Links</dt><dd><ul>
        {% for link in links %}<li><a href="{{ link.url }}" target="_blank" rel="noopener">{{ link.label }} <span aria-hidden="true">↗</span></a></li>{% endfor %}
      </ul></dd></div>
      {% endif %}
      {% for f in facts %}<div class="fact"><dt>{{ f.label }}</dt><dd>{{ f.value }}</dd></div>{% endfor %}
    </dl>
  </section>

  {% if heroImage %}
  <div class="hero-image">
    <span><img src="/images/{{ heroImage }}" alt="{{ heroImageAlt or title }}"></span>
  </div>
  {% endif %}

  <div class="case-body">
    {{ content | safe }}
  </div>

  {% if year %}<div class="case-year">{{ year }}</div>{% endif %}

  </article>

  {% include "partials/footer.njk" %}
</div>

<script src="/js/lightbox.js?v={{ site.version }}" defer></script>
<script>
  const coords = document.getElementById('coords');
  document.addEventListener('mousemove', (e) => {
    coords.textContent = `x: ${String(e.clientX).padStart(3,'0')} / y: ${String(e.clientY).padStart(3,'0')}`;
  });

  const viewportReadout = document.getElementById('viewport-readout');
  function renderViewport(){
    viewportReadout.textContent = `viewport: ${window.innerWidth}×${window.innerHeight}`;
  }
  window.addEventListener('resize', renderViewport);
  renderViewport();


</script>
</body>
</html>
