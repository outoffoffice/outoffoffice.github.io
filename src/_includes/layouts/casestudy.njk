<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>OutOff — {{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/shared.css">
<link rel="stylesheet" href="/css/image-blocks.css">
<style>
  .wrap{position:relative; max-width:1440px; margin:0 auto; overflow-x:hidden; min-height:100vh; display:flex; flex-direction:column;}
  footer.strip{margin-top:auto;}

  /* ---- project header ---- */
  .project-head{
    position:relative; z-index:2;
    padding:80px 40px 60px;
    border-bottom:1px solid var(--ink);
  }
  .kicker{
    font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--blue);
    display:flex; align-items:center; gap:10px; margin-bottom:20px;
  }
  .kicker::before{content:''; width:8px; height:8px; background:var(--lime); display:inline-block;}

  h1{max-width:820px;}

  .dek{
    margin-top:22px; max-width:560px; font-size:17px; line-height:1.6; color:var(--ink); opacity:0.85;
  }

  /* meta strip — table-like, technical */
  .meta-strip{
    display:grid; grid-template-columns:repeat(4, 1fr);
    border-top:1px solid var(--ink); margin-top:52px;
  }
  .meta-cell{
    border-right:1px solid var(--ink); padding:16px 20px;
    font-family:'JetBrains Mono', monospace;
  }
  .meta-cell:last-child{border-right:none;}
  .meta-cell .label{font-size:11px; opacity:0.55; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:6px;}
  .meta-cell .value{font-size:14px;}

  /* ---- hero image ---- */
  .hero-image{
    width:1600px;
    max-width:calc(100% - 80px);
    margin:40px auto 0;
    aspect-ratio:16/9;
    overflow:hidden;
    border-radius:14px;
    box-shadow:0 20px 50px -20px rgba(21,21,26,0.25);
  }
  .hero-image span{display:block; width:100%; height:100%;}
  .hero-image img{width:100%; height:100%; object-fit:cover; object-position:center; display:block;}

  /* ---- free-form markdown body: arbitrary number of ## sections, no
     fixed 01-04 / label-column scheme anymore. Each h2 gets a muted top
     divider instead of a numbered section-label column. ---- */
  .case-body{
    position:relative; z-index:2;
    padding:56px 40px;
    max-width:820px;
  }
  .case-body h2{
    font-family:'Montserrat', sans-serif; font-weight:800; font-size:26px; letter-spacing:-0.01em;
    margin-top:56px; padding-top:32px; border-top:1px solid var(--grid);
    margin-bottom:16px;
  }
  .case-body h2:first-child{margin-top:0; padding-top:0; border-top:none;}
  .case-body p{font-size:15px; line-height:1.7; margin-bottom:14px;}
  .case-body p:last-child{margin-bottom:0;}
  .case-body .highlight{
    background:var(--lime); padding:2px 6px; box-decoration-break:clone; -webkit-box-decoration-break:clone;
  }

  /* next project */
  .next{
    position:relative; z-index:2;
    padding:64px 40px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;
  }
  .next .label{font-family:'JetBrains Mono', monospace; font-size:12px; opacity:0.55; margin-bottom:8px;}
  .next h3{font-family:'Montserrat', sans-serif; font-weight:800; font-size:32px;}
  .next a{
    font-family:'JetBrains Mono', monospace; font-size:13px; border:1px solid var(--ink); border-radius:999px;
    padding:14px 22px; text-decoration:none; color:var(--ink); transition:background 0.2s, color 0.2s, transform 0.15s ease-out;
  }
  .next a:hover{background:var(--ink); color:var(--paper);}

  @media (max-width: 720px){
    .meta-strip{grid-template-columns:repeat(2, 1fr);}
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="grid-bg"></div>

  <header>
    <div class="header-inner content-col">
      <a href="/" class="logo"><span class="brand">OutOff</span><span class="us">_</span><span class="signature">Derek Milai, Creative Technologist</span></a>
      <a href="/work/" class="back">← all work</a>
    </div>
  </header>

  <div class="viewport-readout" id="viewport-readout">viewport: —</div>
  <div class="coords" id="coords">x: 000 / y: 000</div>

  <section class="project-head">
    <div class="kicker">{{ kicker }}</div>
    <h1>{{ title }}</h1>
    {% if dek %}<p class="dek">{{ dek }}</p>{% endif %}

    <div class="meta-strip">
      <div class="meta-cell">
        <div class="label">Role</div>
        <div class="value">{{ role }}</div>
      </div>
      <div class="meta-cell">
        <div class="label">Timeframe</div>
        <div class="value">{{ timeframe }}</div>
      </div>
      <div class="meta-cell">
        <div class="label">Stack</div>
        <div class="value">{{ stack }}</div>
      </div>
    </div>
  </section>

  {% if heroImage %}
  <div class="hero-image">
    <span><img src="/images/{{ heroImage }}" alt="{{ heroImageAlt or title }}"></span>
  </div>
  {% endif %}

  <div class="case-body">
    {{ content | safe }}
  </div>

  {% if nextProjectLabel %}
  <div class="next">
    <div>
      <div class="label">next project</div>
      <h3>{{ nextProjectLabel }}</h3>
    </div>
    <a href="{{ nextProjectHref or '#' }}">view</a>
  </div>
  {% endif %}

  <footer class="strip">
    <div class="footer-inner content-col">
      <div class="strip-row">
        <span>OutOff — Derek Milai — © 2026</span>
        <span id="visitor-loc">locating visitor…</span>
      </div>
    </div>
  </footer>
</div>

<script>
  const coords = document.getElementById('coords');
  document.addEventListener('mousemove', (e) => {
    coords.textContent = `x: ${String(e.clientX).padStart(3,'0')} / y: ${String(e.clientY).padStart(3,'0')}`;
  });

  const viewportReadout = document.getElementById('viewport-readout');
  function renderViewport(){
    viewportReadout.textContent = `viewport: ${window.innerWidth}×${window.innerHeight}`;
  }
  window.addEventListener('resize', renderViewport);
  renderViewport();

  const visitorLoc = document.getElementById('visitor-loc');
  fetch('https://ipapi.co/json/')
    .then(res => res.json())
    .then(data => {
      if (data && data.city) {
        const lat = Number(data.latitude).toFixed(2);
        const lon = Number(data.longitude).toFixed(2);
        visitorLoc.textContent = `visiting from ${data.city}, ${data.country_name} — ${lat}°, ${lon}°`;
      } else {
        visitorLoc.textContent = 'visitor location unavailable';
      }
    })
    .catch(() => {
      visitorLoc.textContent = 'visitor location unavailable';
    });

  // Magnetic hover, same as everywhere else on the site.
  function applyMagnetic(el, radius, maxOffset) {
    document.addEventListener('mousemove', (e) => {
      const rect = el.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = e.clientX - cx;
      const dy = e.clientY - cy;
      const dist = Math.hypot(dx, dy);
      if (dist < radius) {
        const pull = (1 - dist / radius) * maxOffset;
        const angle = Math.atan2(dy, dx);
        el.style.transform = `translate(${(Math.cos(angle) * pull).toFixed(2)}px, ${(Math.sin(angle) * pull).toFixed(2)}px)`;
      } else {
        el.style.transform = '';
      }
    });
  }
  const nextButton = document.querySelector('.next a');
  if (nextButton) applyMagnetic(nextButton, 85, 12);
</script>
</body>
</html>
