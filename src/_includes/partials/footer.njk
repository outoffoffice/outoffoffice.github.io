<footer class="site-footer">
  <div class="footer-inner content-col grid">
    <!-- three small stacks on the page grid's first columns, then links and
         the color-mode toggle on the right (see .site-footer in shared.css) -->
    <p class="footer-col">
      <span class="footer-brand">OutOff_</span>
      <span>© {{ site.built | truncate(4, true, "") }} Derek Milai</span>
    </p>
    <p class="footer-col">
      <span>built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener">Eleventy</a></span>
      <span>last build {{ site.built }}</span>
    </p>
    <p class="footer-col">
      <span>no cookies, no tracking</span>
      <span><a href="/impressum/">imprint &amp; privacy</a></span>
    </p>
    <ul class="footer-links">
      <li><a href="#" data-email>email</a></li>
      <li><a href="https://www.linkedin.com/in/derek-milai-kunstmann/" target="_blank" rel="noopener">linkedin</a></li>
      <li><a href="https://github.com/outoffoffice" target="_blank" rel="noopener">github</a></li>
    </ul>
    <div class="theme-toggle" role="group" aria-label="Color mode">
      <button type="button" data-mode="paper" aria-pressed="true">paper</button>
      <button type="button" data-mode="dark" aria-pressed="false">dark</button>
    </div>
  </div>
</footer>
<script src="/js/footer.js?v={{ site.version }}" defer></script>
